{
  "Application.Configuration": {
    "ApplicationName": "CampusHub",
    "Environment": {
      "loggingName": "CampusHub.Catalog"
    }
  },
  "Application.Dependency": {
    "RegisterTypes": [
      "Arc4u.AppSettings, Arc4u.Configuration",
      "Arc4u.Security.Cryptography.X509CertificateLoader, Arc4u",
      "Arc4u.Caching.Memory.MemoryCache, Arc4u.Caching.Memory",
      "Arc4u.Caching.CacheContext, Arc4u.Caching",
      "Arc4u.TimeZoneContext, Arc4u",
      "Arc4u.Diagnostics.DefaultLoggingProperties, Arc4u",
      "Arc4u.OAuth2.Security.Principal.KeyGeneratorFromIdentity, Arc4u.OAuth2.AspNetCore",
      "Arc4u.OAuth2.Security.UserObjectIdentifier, Arc4u.OAuth2.AspNetCore",
      "Arc4u.Security.Principal.ClaimsProfileFiller, Arc4u",
      "Arc4u.Security.Principal.ClaimsAuthorizationFiller, Arc4u",
      "Arc4u.OAuth2.Token.ApplicationCache, Arc4u.OAuth2",
      "Arc4u.OAuth2.TokenProvider.CredentialTokenProvider, Arc4u.OAuth2",
      "Arc4u.OAuth2.TokenProvider.CredentialTokenCacheTokenProvider, Arc4u.OAuth2.AspNetCore",
      "Arc4u.OAuth2.Token.CacheHelper, Arc4u.OAuth2",
      "Arc4u.OAuth2.AppPrincipalTransform, Arc4u.OAuth2.AspNetCore",
      "Arc4u.Authorization.ApplicationAuthorizationPolicy, Arc4u.Authorization",
      "Arc4u.OAuth2.AspNetCore.ScopedServiceProviderAccessor, Arc4u.OAuth2.AspNetCore",
      "Arc4u.OAuth2.TokenProviders.BootstrapContextTokenProvider, Arc4u.OAuth2.AspNetCore.Authentication"
    ],
    "Assemblies": [
      {
        "Assembly": "CampusHub.Catalog.Infrastructure.Courses"
      }
    ]
  },
  "HealthChecksUI": {
    "EvaluationTimeinSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.OpenTelemetry",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Async",
      "Serilog.Expressions",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Serilog": "Warning",
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning",
        "Grpc": "Warning",
        "Yarp": "Warning",
        "HealthChecks.UI": "Warning",
        "Polly": "Warning",
        "Gtw": "Information"
      }
    },
    "WriteTo:ConsoleLogger": {
      "Name": "Logger",
      "Args": {
        "configureLogger": {
          "MinimumLevel": "Warning",
          "Filter": [
            {
              "Name": "ByExcluding",
              "Args": {
                "expression": "Category = 4"
              }
            }
          ],
          "WriteTo": [
            {
              "Name": "Async",
              "Args": {
                "configure": [
                  {
                    "Name": "Console",
                    "Args": {
                      "outputTemplate": "[{Timestamp:HH:mm:ss} {SourceContext} [{Level}] {Message}{NewLine}{Exception}",
                      "theme": "Serilog.Sinks.SystemConsole.Themes.SystemConsoleTheme::Grayscale, Serilog.Sinks.Console"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "Enrich": [
      "WithMachineName"
    ],
    "Properties": {
      "Application": "CampusHub.Catalog"
    }
  }
}