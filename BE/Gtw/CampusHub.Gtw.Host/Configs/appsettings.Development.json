{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    }
  },
  "Application.Configuration": {
    "Environment": {
      "name": "Development",
      "timeZone": "Romance Standard Time"
    }
  },
  "Csp": {
    "ConnectSrc": "https://localhost:*,ws://localhost:*,http://localhost:*,https://authdev.arc4u.net/oidc/session",
    "DefaultSrc": "https://localhost:*/favicon.ico",
    "FontSrc": "https://fonts.gstatic.com",
    "ImgSrc": "https://avatars3.githubusercontent.com/u/25212406"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {}
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "Category = 4"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "address": "http://dummy.address.for.nswag",
    "header": "",
    "attributes": {},
    "sources": [
      "Arc4u",
      "CampusHub.Gtw"
    ]
  },
  "Caching": {
    "Default": "Volatile",
    "Caches": [
      {
        "Name": "Volatile",
        "Kind": "Memory",
        "Settings": {
          "SizeLimitInMB": "512"
        },
        "IsAutoStart": true
      }
    ]
  },
  "EncryptionCertificate": {
    "Store": {
      "Name": "encryptorSha2dev.belgrid.net",
      "Location": "CurrentUser"
    }
  },
  "Authentication": {
    "ResourcesRights": {
      "ResourcesPolicies": {
        "facade": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/openapi/frontend.json"
        },
        "interface": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/openapi/service.json"
        }
      }
    },
    "ClaimsMiddleware": {
      "ForceOpenId": {
        "ForceAuthenticationForPaths": [
          "/swagger*",
          "/healthchecks-ui*",
          "/enrollment/jobs*",
          "/grading/jobs*"
        ]
      }
    },
    "DataProtection": {
      "EncryptionCertificate": {
        "Store": {
          "Name": "encryptorSha2dev.belgrid.net",
          "Location": "CurrentUser"
        }
      },
      "CacheStore": {
        "CacheKey": "DataProtection-Development-Store",
        "CacheName": "Volatile"
      }
    },
    "DefaultAuthority": {
      "Url": "https://authdev.arc4u.net/oidc"
    },
    "CookieName": "CampusHub.ApiGtw.Cookies",
    "ValidateAuthority": true,
    "ValidateAudience": true,
    "OAuth2.Settings": {
      "Scopes": [
        "access.application"
      ],
      "Audiences": [
        "http://guidance/api"
      ]
    },
    "OpenId.Settings": {
      "TokenEndpoint": {
        "resource": "http://guidance/api"
      },
      "ClientId": "rojg0smfo5fkwzj6xmoz9",
      "ClientSecret": "Set in configs/appsettings.Development.local.json (not in git)",
      "Audiences": [
        "http://guidance/api"
      ],
      "Scopes": [
        "openid",
        "profile",
        "offline_access",
        "access.application"
      ]
    },
    "TokenCache": {
      "CacheName": "Volatile",
      "MaxTime": "01:00:00"
    },
    "ClaimsIdentifier": [
      "sub"
    ],
    "ForceRefreshTimeoutTimeSpan": "00:05:00",
    "AuthenticationCacheTicketStore": {
      "CacheName": "Volatile"
    }
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Catalog",
        "Uri": "https://localhost:7184/catalog/healthz"
      },
      {
        "Name": "Enrollment",
        "Uri": "https://localhost:7184/enrollment/healthz"
      },
      {
        "Name": "Billing",
        "Uri": "https://localhost:7184/billing/healthz"
      },
      {
        "Name": "Grading",
        "Uri": "https://localhost:7184/grading/healthz"
      },
      {
        "Name": "Notification",
        "Uri": "https://localhost:7184/notification/healthz"
      }
    ]
  }
}