{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    }
  },
  "Application.Configuration": {
    "Environment": {
      "name": "Production",
      "timeZone": "Romance Standard Time"
    }
  },
  "Csp": {
    "ConnectSrc": "https://campushub.prod.arc4u.net:*,ws://campushub.prod.arc4u.net:*,http://campushub.prod.arc4u.net:*,https://authdev.arc4u.net/oidc/session",
    "DefaultSrc": "https://campushub.prod.arc4u.net:*/favicon.ico",
    "FontSrc": "https://fonts.gstatic.com",
    "ImgSrc": "https://avatars3.githubusercontent.com/u/25212406"
  },
  "Serilog": {
    "WriteTo:SeqLogger": {
      "Name": "Logger",
      "Args": {
        "configureLogger": {
          "MinimumLevel": "Verbose",
          "WriteTo": [
            {
              "Name": "Seq",
              "Args": {
                "serverUrl": "http://seqingest:5341"
              }
            }
          ]
        }
      }
    }
  },
  "OpenTelemetry": {
    "address": "http://localhost:5341/ingest/otlp/v1/traces",
    "header": "X-Seq-ApiKey:000",
    "attributes": {},
    "sources": [
      "Arc4u",
      "CampusHub.Gtw"
    ]
  },
  "EncryptionCertificate": {
    "File": {
      "Cert": "certs/cert.pem",
      "Key": "certs/privkey.pem"
    }
  },
  "Authentication": {
    "DefaultAuthority": {
      "Url": "$(openid_authority)",
      "MetaDataAddress": "$(ida_metadataaddress)"
    },
    "AuthenticationCacheTicketStore": {
      "CacheName": "Volatile"
    },
    "DataProtection": {
      "EncryptionCertificate": {
        "Store": {
          "Name": "encryptorSha2dev.belgrid.net"
        }
      },
      "CacheStore": {
        "CacheKey": "DataProtection-CampusHub-Production-Store",
        "CacheName": "Volatile"
      }
    },
    "TokenCache": {
      "CacheName": "Volatile",
      "MaxTime": "01:00:00"
    },
    "ResourcesRights": {
      "ResourcesPolicies": {
        "facade": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/openapi/frontend.json"
        },
        "interface": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/openapi/service.json"
        }
      }
    },
    "CookieName": "CampusHub.ApiGtw.Cookies",
    "ValidateAuthority": true,
    "OAuth2.Settings": {
      "Audiences": [
        "$(oauth2_audiences)"
      ],
      "Scopes": [
        "$(oauth2_scopes)"
      ]
    },
    "OpenId.Settings": {
      "ClientId": "fe95d22c-bf4a-41fe-9c14-3d102c126e96",
      "ClientSecret": "Decrypt:???",
      "Audiences": [
        "$(oauth2_audiences)"
      ],
      "Scopes": [
        "openid",
        "offline_access",
        "profile",
        "$(oauth2_scopes)"
      ]
    },
    "ClaimsMiddleware": {
      "ForceOpenId": {
        "ForceAuthenticationForPaths": [
          "/swagger*",
          "/healthchecks-ui*",
          "/enrollment/jobs*",
          "/grading/jobs*"
        ]
      },
      "ClaimsFiller": {
        "AuthenticationSettingsKeys": [
          "OpenId"
        ]
      }
    }
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "Catalog",
        "Uri": "https://campushub.prod.arc4u.net/catalog/healthz"
      },
      {
        "Name": "Enrollment",
        "Uri": "https://campushub.prod.arc4u.net/enrollment/healthz"
      },
      {
        "Name": "Billing",
        "Uri": "https://campushub.prod.arc4u.net/billing/healthz"
      },
      {
        "Name": "Grading",
        "Uri": "https://campushub.prod.arc4u.net/grading/healthz"
      },
      {
        "Name": "Notification",
        "Uri": "https://campushub.prod.arc4u.net/notification/healthz"
      }
    ]
  }
}