{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    }
  },
  "Application.Configuration": {
    "Environment": {
      "name": "Production",
      "timeZone": "Romance Standard Time"
    }
  },
  "Serilog": {
    "WriteTo:SeqLogger": {
      "Name": "Logger",
      "Args": {
        "configureLogger": {
          "MinimumLevel": "Verbose",
          "WriteTo": [
            {
              "Name": "Seq",
              "Args": {
                "serverUrl": "http://seqingest:5341"
              }
            }
          ]
        }
      }
    }
  },
  "OpenTelemetry": {
    "address": "http://localhost:5341/ingest/otlp/v1/traces",
    "header": "X-Seq-ApiKey:000",
    "attributes": {},
    "sources": [
      "Arc4u",
      "CampusHub.Enrollment"
    ]
  },
  "Caching": {
    "Default": "Volatile",
    "Caches": [
      {
        "Name": "Volatile",
        "Kind": "Memory",
        "Settings": {
          "SizeLimitInMB": "512"
        },
        "IsAutoStart": true
      },
      {
        "Name": "workflowstate",
        "Kind": "Dapr",
        "Settings": {
          "Name": "campushub-workflowstate-statestore"
        },
        "IsAutoStart": "True"
      }
    ]
  },
  "EncryptionCertificate": {
    "File": {
      "Cert": "certs/cert.pem",
      "Key": "certs/privkey.pem"
    }
  },
  "Authentication": {
    "ResourcesRights": {
      "ResourcesPolicies": {
        "facade": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/enrollment/swagger/facade/swagger.json"
        },
        "interface": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/enrollment/swagger/interface/swagger.json"
        }
      }
    },
    "DefaultAuthority": {
      "Url": "https://authdev.arc4u.net/oidc"
    },
    "ValidateAuthority": true,
    "ValidateAudience": true,
    "OAuth2.Settings": {
      "Scopes": [
        "access.application"
      ],
      "Audiences": [
        "http://guidance/api"
      ]
    },
    "TokenCache": {
      "CacheName": "ClamsCache",
      "MaxTime": "01:00:00"
    },
    "ClaimsIdentifier": [
      "sub"
    ],
    "ForceRefreshTimeoutTimeSpan": "00:05:00",
    "ClaimsMiddleware": {
      "ClaimsFiller": {
        "AuthenticationSettingsKeys": []
      }
    },
    "ClientTokens": {
      "Service": {
        "Scenario": "ClientCredentials",
        "Scopes": [
          "access.application"
        ],
        "Settings": {
          "ClientId": "Copy the ClientId for Production",
          "ClientSecret": "Copy the ClientSecret for Production",
          "resource": "http://guidance/api"
        }
      }
    }
  },
  "ConnectionStrings": {
    "CampusHub_Enrollment": "mongodb://localhost:27018/CampusHub_Enrollment",
    "HangfireConnection": "mongodb://localhost:27018/CampusHub_Enrollment_Jobs"
  }
}