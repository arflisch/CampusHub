{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    }
  },
  "Application.Configuration": {
    "Environment": {
      "name": "Development",
      "timeZone": "Romance Standard Time"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {}
      }
    ],
    "Filter": [
      {
        "Name": "ByExcluding",
        "Args": {
          "expression": "Category = 4"
        }
      }
    ]
  },
  "OpenTelemetry": {
    "address": "http://dummy.address.for.nswag",
    "header": "",
    "attributes": {},
    "sources": [
      "Arc4u",
      "CampusHub.Enrollment"
    ]
  },
  "Caching": {
    "Default": "Volatile",
    "Caches": [
      {
        "Name": "Volatile",
        "Kind": "Memory",
        "Settings": {
          "SizeLimitInMB": "512"
        },
        "IsAutoStart": true
      },
      {
        "Name": "workflowstate",
        "Kind": "Dapr",
        "Settings": {
          "Name": "campushub-workflowstate-statestore"
        },
        "IsAutoStart": "True"
      }
    ]
  },
  "EncryptionCertificate": {
    "Store": {
      "Name": "encryptorSha2dev.belgrid.net",
      "Location": "CurrentUser"
    }
  },
  "Authentication": {
    "ResourcesRights": {
      "ResourcesPolicies": {
        "facade": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/enrollment/swagger/facade/swagger.json"
        },
        "interface": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/enrollment/swagger/interface/swagger.json"
        }
      }
    },
    "DefaultAuthority": {
      "Url": "https://authdev.arc4u.net/oidc"
    },
    "ValidateAuthority": true,
    "ValidateAudience": true,
    "OAuth2.Settings": {
      "Scopes": [
        "access.application"
      ],
      "Audiences": [
        "http://guidance/api"
      ]
    },
    "TokenCache": {
      "CacheName": "ClamsCache",
      "MaxTime": "01:00:00"
    },
    "ClaimsIdentifier": [
      "sub"
    ],
    "ForceRefreshTimeoutTimeSpan": "00:05:00",
    "ClaimsMiddleware": {
      "ClaimsFiller": {
        "AuthenticationSettingsKeys": []
      }
    },
    "ClientTokens": {
      "Service": {
        "Scenario": "ClientCredentials",
        "Scopes": [
          "access.application"
        ],
        "Settings": {
          "ClientId": "hgxgbi1tryp55zladslxw",
          "ClientSecret": "Set in configs/appsettings.Development.local.json (not in git)",
          "resource": "http://campushub/api"
        }
      }
    }
  },
  "ConnectionStrings": {
    "CampusHub_Enrollment": "mongodb://localhost:27018/CampusHub_Enrollment",
    "HangfireConnection": "mongodb://localhost:27018/CampusHub_Enrollment_Jobs"
  }
}