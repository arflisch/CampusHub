{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2AndHttp3"
    }
  },
  "Application.Configuration": {
    "Environment": {
      "name": "Staging",
      "timeZone": "Romance Standard Time"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Verbose"
    },
    "WriteTo:OpenTelemetryLogger": {
      "Name": "Logger",
      "Args": {
        "configureLogger": {
          "Filter": [
            {
              "Name": "ByExcluding",
              "Args": {
                "expression": "Category = 'Monitoring'"
              }
            }
          ],
          "WriteTo": [
            {
              "Name": "OpenTelemetry",
              "Args": {}
            }
          ]
        }
      }
    }
  },
  "OpenTelemetry": {
    "address": "http://localhost:5341/ingest/otlp/v1/traces",
    "header": "X-Seq-ApiKey:000",
    "attributes": {},
    "sources": [
      "Arc4u",
      "CampusHub.Billing"
    ]
  },
  "Caching": {
    "Default": "Volatile",
    "Caches": [
      {
        "Name": "Volatile",
        "Kind": "Memory",
        "Settings": {
          "SizeLimitInMB": "512"
        },
        "IsAutoStart": true
      }
    ]
  },
  "EncryptionCertificate": {
    "File": {
      "Cert": "certs/cert.pem",
      "Key": "certs/privkey.pem"
    }
  },
  "Authentication": {
    "ResourcesRights": {
      "ResourcesPolicies": {
        "facade": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/billing/swagger/facade/swagger.json"
        },
        "interface": {
          "AuthorizationPolicy": "CanSeeSwaggerFrontendApi",
          "Path": "/billing/swagger/interface/swagger.json"
        }
      }
    },
    "DefaultAuthority": {
      "Url": "https://authdev.arc4u.net/oidc"
    },
    "ValidateAuthority": true,
    "ValidateAudience": true,
    "OAuth2.Settings": {
      "Scopes": [
        "access.application"
      ],
      "Audiences": [
        "http://guidance/api"
      ]
    },
    "TokenCache": {
      "CacheName": "ClamsCache",
      "MaxTime": "01:00:00"
    },
    "ClaimsIdentifier": [
      "sub"
    ],
    "ForceRefreshTimeoutTimeSpan": "00:05:00",
    "ClaimsMiddleware": {
      "ClaimsFiller": {
        "AuthenticationSettingsKeys": []
      }
    }
  },
  "ConnectionStrings": {
    "CampusHub_Billing": "mongodb://localhost:27018/CampusHub_Billing"
  }
}