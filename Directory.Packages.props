    <PackageVersion Include="Arc4u.OAuth2.Blazor" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.OAuth2.Client" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Results" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Serializer" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Serializer.JSon" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.FluentValidation" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.MongoDB" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.2" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.6.2" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Uris" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Publisher.Seq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageVersion Include="ChilkatDnCore" Version="11.5.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.Dapr" Version="13.0.0" />
    <PackageVersion Include="CommunityToolkit.Aspire.Hosting.OpenTelemetryCollector" Version="13.6.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.0" />
    <PackageVersion Include="Dapr.AspNetCore" Version="$(DaprVersion)" />
    <PackageVersion Include="Dapr.Client" Version="$(DaprVersion)" />
    <PackageVersion Include="Dapr.Actors.AspNetCore" Version="$(DaprVersion)" />
    <PackageVersion Include="Dapr.Workflow" Version="$(DaprVersion)" />
    <PackageVersion Include="Duende.IdentityModel.OidcClient" Version="6.0.1" />
    <PackageVersion Include="FluentResults" Version="4.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.84.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <!-- HealthChecks.UI.dll references the legacy IdentityModel 5.2.0 assembly (its OAuth collector) but
         AspNetCore.HealthChecks.UI 9.0.0's nuspec omits the dependency, so the collector HostedService
         throws "Could not load file or assembly 'IdentityModel, Version=5.2.0.0'" on every poll. Restore
         it explicitly; 7.0.0 (assembly 7.0.0.0) satisfies the reference and is the last legacy version. -->
    <PackageVersion Include="IdentityModel" Version="7.0.0" />
    <!-- Transitive via AspNetCore.HealthChecks.UI; pinned to patched version for GHSA-w7r3-mgwf-4mqq (NU1902). -->
    <PackageVersion Include="KubernetesClient" Version="19.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(DotNetVersion)" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotNetVersion)" />
