    <PackageVersion Include="SharpCompress" Version="0.50.4" />
    <PackageVersion Include="MongoDB.Bson" Version="3.12.0" />
    <PackageVersion Include="McMaster.Extensions.CommandLineUtils" Version="5.1.0" />
