<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Arc4uVersion>9.0.0-preview38</Arc4uVersion>
    <DaprVersion>1.18.10</DaprVersion>
    <DotNetVersion>11.0.0-rc.2.26504.105</DotNetVersion>
    <OpenTelemetryVersion>1.18.0</OpenTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AutoFixture.AutoMoq" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageVersion Include="Arc4u" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.AspNetCore.gRpc" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.AspNetCore.Results" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Authorization" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Caching" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Caching.Dapr" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Caching.Memory" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Caching.Redis" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Configuration" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Configuration.Decryptor" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Dependency" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Dependency.Tool" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Diagnostics" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Diagnostics.Serilog" Version="$(Arc4uVersion)" />
    <PackageVersion Include="Arc4u.Dispatcher" Version="$(Arc4uVersion)" />
