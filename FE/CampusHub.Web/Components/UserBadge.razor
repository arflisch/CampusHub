@inherits ViewModelComponentBase<ShellViewModel>
@inject AppMode Mode

@* Who is signed in, and the sign-out link of the gateway (it ends the cookie session and the OIDC session). *@
<div class="user">
    @if (ViewModel.User is { } user)
    {
        <span class="avatar" aria-hidden="true">@Initials(user.DisplayName)</span>
        <span class="user-name">@user.DisplayName</span>
    }
    @if (!Mode.IsDemo)
    {
        <a class="link-muted" href="frontend/Environment/logout?returnUrl=/">Sign out</a>
    }
</div>

@code {
    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
