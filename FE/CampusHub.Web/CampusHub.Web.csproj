<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Blazor WebAssembly front, MVVM: thin Razor views bound to the ViewModels of CampusHub.Web.Presentation.
    In every environment it is served by the gateway (Gtw), which is also its BFF: the browser holds an HttpOnly
    session cookie, the gateway attaches the access token to the calls it proxies, no token ever reaches JavaScript.
    To work on the UI alone, run it in Demo mode (in-memory backend, no gateway):
      dotnet run -p:WasmApplicationEnvironmentName=Demo
    Since .NET 10 the WebAssembly environment is fixed at build time by this property (it selects
    wwwroot/appsettings.Demo.json); ASPNETCORE_ENVIRONMENT no longer reaches the browser.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CampusHub.Web.Presentation\CampusHub.Web.Presentation.csproj" />
  </ItemGroup>

</Project>
