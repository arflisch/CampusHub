@page "/enrollments"
@inherits ViewModelComponentBase<MyEnrollmentsViewModel>

<PageTitle>My enrollments · CampusHub</PageTitle>

<div class="page-head">
    <div>
        <h1>My enrollments</h1>
        <p class="muted">
            Each request runs a saga: hold a seat, then confirm it.
            @if (ViewModel.IsPolling)
            {
                <span class="live"><span class="dot"></span>Updating live</span>
            }
        </p>
    </div>
    <CommandButton Command="ViewModel.LoadCommand" CssClass="btn btn-ghost" BusyText="Refreshing…">Refresh</CommandButton>
</div>

<Banner Message="@ViewModel.ErrorMessage" OnDismiss="() => ViewModel.DismissErrorCommand.Execute(null)" />
<Banner Message="@ViewModel.InfoMessage" Kind="info" />

@if (ViewModel.IsEmpty && !ViewModel.LoadCommand.IsRunning)
{
    <div class="empty">You have not requested any enrollment yet. <a href="">Browse the catalogue</a>.</div>
}
else
{
    <ul class="list">
        @foreach (var enrollment in ViewModel.Enrollments)
        {
            <li class="row" @key="enrollment.Id">
                <div>
                    <div class="row-title">@(enrollment.CourseTitle ?? "Course")</div>
                    <div class="muted small">
                        Requested @enrollment.RequestedAt.ToLocalTime().ToString("g")
                        @if (enrollment.CourseStartsAt is { } startsAt)
                        {
                            <span> · starts @startsAt.ToString("d MMM yyyy")</span>
                        }
                        @if (enrollment.State == EnrollmentState.Rejected)
                        {
                            <span> · @MyEnrollmentsViewModel.DescribeRejection(enrollment)</span>
                        }
                        @if (enrollment.State == EnrollmentState.Cancelled)
                        {
                            <span> · @(enrollment.CancellationReason == "course.cancelled" ? "the course was cancelled by its teacher" : "cancelled by you")@(enrollment.CoursePriceInCents > 0 ? ", refunded" : string.Empty)</span>
                        }
                    </div>
                </div>
                <div class="steps" aria-label="Saga progress">
                    <span class="step @(enrollment.State != EnrollmentState.Rejected ? "done" : "failed")">Requested</span>
                    <span class="step @(enrollment.State is EnrollmentState.SeatHeld or EnrollmentState.Paid or EnrollmentState.Confirmed or EnrollmentState.Cancelled ? "done" : string.Empty)">Seat held</span>
                    @if (enrollment.CoursePriceInCents > 0)
                    {
                        <span class="step @(enrollment.State is EnrollmentState.Paid or EnrollmentState.Confirmed or EnrollmentState.Cancelled ? "done" : string.Empty)">Paid @Money.Format(enrollment.CoursePriceInCents)</span>
                    }
                    <span class="step @(enrollment.State is EnrollmentState.Confirmed or EnrollmentState.Cancelled ? "done" : string.Empty)">Confirmed</span>
                    @if (enrollment.State == EnrollmentState.Cancelled)
                    {
                        <span class="step failed">Cancelled</span>
                    }
                </div>
                <div class="row-actions">
                    <StatusBadge Enrollment="enrollment.State" />
                    @if (ViewModel.CanCancel(enrollment))
                    {
                        if (_confirming == enrollment.Id)
                        {
                            <CommandButton Command="ViewModel.CancelCommand" Parameter="enrollment" CssClass="btn btn-danger" BusyText="Cancelling…">
                                Confirm@(enrollment.CoursePriceInCents > 0 ? $" (refund {Money.Format(enrollment.CoursePriceInCents)})" : string.Empty)
                            </CommandButton>
                            <button type="button" class="btn btn-ghost" @onclick="() => _confirming = null">Keep it</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-ghost" @onclick="() => _confirming = enrollment.Id">Cancel enrollment</button>
                        }
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    // Two-step cancellation: the first click asks to confirm, the second one cancels.
    private Guid? _confirming;
}
